SECRET_KEY=focusguard-ai-dev-secret-key-change-in-prod-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3

# Hugging Face Configuration
HF_API_KEY=your_hugging_face_key_here
HF_LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.2
HF_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB Vector Storage Directory
CHROMA_PERSIST_DIR=./chroma_db

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500

# Desktop Agent account. These must match the account used in the dashboard.
AGENT_API_BASE=http://127.0.0.1:8000/api
AGENT_USERNAME=admin
AGENT_PASSWORD=admin123
AGENT_POLL_SECS=3

# Google Identity Services web client.
# In Google Cloud Console, add these authorized JavaScript origins:
# http://localhost:8000
# http://127.0.0.1:8000
# Also add these under Authorized redirect URIs (the screenshot currently has none):
# http://localhost:8000/api/auth/google/redirect/
# http://127.0.0.1:8000/api/auth/google/redirect/
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
